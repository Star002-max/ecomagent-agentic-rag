# Copy to .env; never commit .env. Environment variables override this file.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-endpoint.example/compatible-mode/v1
LLM_MODEL=your_model_name

# RAG defaults to LocalHashEmbeddings and does not need embedding credentials.
# Set EMBEDDING_PROVIDER=aliyun only when you intentionally want paid/API-backed embeddings.
EMBEDDING_PROVIDER=local_hash
# For Alibaba Cloud Model Studio (Beijing), uncomment and fill these locally:
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_BASE_URL=https://your_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
